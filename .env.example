# =============================================================================
# CampusQuest — environment variables
# Copy this file to `.env` (repo root) AND fill `client/.env` for Vite keys.
# Never commit real secrets.
# =============================================================================

# --- Server (repo root `.env`) ---
PORT=2567
NODE_ENV=development
# Optional: lock CORS to your Vite origin in production
# CORS_ORIGIN=https://your-app.vercel.app

# Clerk (Dashboard → API Keys)
# https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Supabase (Project Settings → API)
# https://supabase.com/dashboard
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Optional direct Postgres URL (migrations / tooling) — same project
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# --- Client (create `client/.env`) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Production Colyseus WebSocket URL (omit in local dev — defaults to :2567)
# VITE_SERVER_URL=wss://your-railway-app.up.railway.app
