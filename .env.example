# =============================================================================
# CampusQuest — environment variables
# Copy this file to `.env` (repo root) AND `client/.env` for Vite keys.
# Never commit real secrets — keep them only in `.env` / `client/.env`.
# Full guide: docs/ENV.md
# =============================================================================

# --- Server (repo root `.env`) ---
PORT=2567
NODE_ENV=development
# Optional: lock CORS to your Vite origin in production
# CORS_ORIGIN=https://your-app.vercel.app

# Clerk (Dashboard → API Keys)
# https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# --- Postgres via Prisma (Supabase pooler) ---
# Replace [YOUR-PASSWORD] with the database password from
# Supabase → Project Settings → Database.
#
# Transaction-mode pooler (IPv4) — Prisma Client at runtime
DATABASE_URL="postgresql://postgres.nscybjdvhapdngsuvilq:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — Prisma migrate / db push
DIRECT_URL="postgresql://postgres.nscybjdvhapdngsuvilq:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Optional: still useful for dashboard tooling (not required by Prisma path)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# --- Client (create `client/.env`) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Production Colyseus WebSocket URL (omit in local dev — defaults to :2567)
# VITE_SERVER_URL=wss://your-railway-app.railway.app
