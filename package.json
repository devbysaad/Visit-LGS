{
  "name": "lgs-campusquest",
  "version": "1.0.0",
  "description": "CampusQuest — a 2D multiplayer campus explorer for LGS Wah Cantt (Gudwal), adapted from SkyOffice",
  "main": ".eslintrc.js",
  "scripts": {
    "start": "cd server && ts-node-dev --project tsconfig.server.json --respawn --transpile-only index.ts",
    "client": "cd client && yarn dev",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"yarn start\" \"yarn client\"",
    "heroku-postbuild": "yarn && cd types && yarn && yarn prisma:generate && cd ../server && tsc --project tsconfig.server.json",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "validate-map": "node scripts/validate-map.mjs",
    "gen-map": "python3 tools/gen_lgs_campus.py",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "resolutions": {
    "@types/node": "^16.18.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "eslint": "^7.11.0",
    "minimist": ">=1.2.2",
    "prisma": "6",
    "rimraf": "^2.7.1",
    "ts-node": "^8.1.0",
    "ts-node-dev": "^1.0.0-pre.63"
  },
  "dependencies": {
    "@clerk/backend": "^1",
    "@colyseus/command": "^0.1.7",
    "@colyseus/monitor": "^0.14.0",
    "@colyseus/schema": "^1.0.46",
    "@prisma/client": "6",
    "@supabase/supabase-js": "^2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "colyseus": "^0.14.0",
    "colyseus.js": "^0.14.12",
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "phaser": "^3.55.2",
    "regenerator-runtime": "^0.13.7",
    "typescript": "^4.8.2"
  }
}
